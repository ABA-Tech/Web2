@model Web.Models.Guest

@{
    Layout = null;
    var weddingDate = "2026-02-08T15:00:00";
    var coupleName1 = "Sophie";
    var coupleName2 = "Alexandre";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@coupleName1 & @coupleName2 - Invitation de Mariage</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@200;300;400;500;600&family=Playfair+Display:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    @* <link href="~/css/t1.css" /> *@
    <link rel="stylesheet" href="~/css/t1.css" asp-append-version="true" />
</head>
<body>
    <!-- ========== PAGE D'ACCUEIL ========== -->
    <div class="home-page fade-transition" id="homePage">
        <div class="video-background"></div>
        <div class="mist"></div>
        
        <!-- Rayons de lumière -->
        <div class="light-ray" style="left: 20%;"></div>
        <div class="light-ray" style="left: 40%; animation-delay: 2s;"></div>
        <div class="light-ray" style="left: 60%; animation-delay: 4s;"></div>
        <div class="light-ray" style="left: 80%; animation-delay: 6s;"></div>
        
        <!-- Particules de lumière -->
        <div id="lightParticles"></div>

        <div class="home-content">
            <div class="title-wrapper">
                <h1 class="couple-names">
                    <span class="name">@coupleName1</span>
                    <span class="ampersand">&</span>
                    <span class="name">@coupleName2</span>
                </h1>
                <p class="date-preview">08 Février 2026</p>
            </div>

            <div class="envelope-wrapper">
                <div class="envelope-glow"></div>
                <div class="envelope-container" onclick="openInvitation()">
                    <div class="premium-envelope">
                        <div class="envelope-flap"></div>
                        <div class="wax-seal"></div>
                    </div>
                </div>
            </div>

            <p class="invitation-text">Vous êtes invités</p>
            <div class="click-indicator">
                <i class="fas fa-chevron-down"></i>
            </div>
        </div>
    </div>
    @Html.AntiForgeryToken()

    <!-- ========== PAGE D'INVITATION ========== -->
    <div class="invitation-page fade-transition" id="invitationPage">
        <div class="invitation-bg" id="invitationBg"></div>
        
        <!-- Lignes décoratives -->
        <div class="decorative-line" style="top: 20%; width: 100%; animation-delay: 0s;"></div>
        <div class="decorative-line" style="top: 40%; width: 100%; animation-delay: 2s;"></div>
        <div class="decorative-line" style="top: 60%; width: 100%; animation-delay: 4s;"></div>
        <div class="decorative-line" style="top: 80%; width: 100%; animation-delay: 6s;"></div>

        <div class="content-wrapper">
            <div class="invitation-card">
                <!-- Bordures animées -->
                <div class="card-border card-border-top"></div>
                <div class="card-border card-border-bottom"></div>
                <div class="card-border card-border-left"></div>
                <div class="card-border card-border-right"></div>

                <!-- Coins ornementaux -->
                <div class="corner-ornament corner-tl"></div>
                <div class="corner-ornament corner-tr"></div>
                <div class="corner-ornament corner-bl"></div>
                <div class="corner-ornament corner-br"></div>

                <!-- Header -->
                <div class="card-header">
                    <div class="header-ornament">✦</div>
                    <h2 class="card-title">Célébrons Notre Union</h2>
                    <p class="card-subtitle">Vous êtes cordialement invités</p>
                </div>

                <!-- Corps -->
                <div class="card-body-text">
                    <p>C'est avec une immense joie que nous vous convions à célébrer</p>
                    <p class="names-highlight">@coupleName1 & @coupleName2</p>
                    <p>Rejoignez-nous pour partager ce moment unique et inoubliable</p>
                </div>

                <div class="elegant-divider">
                    <span class="divider-icon">❖</span>
                </div>

                <!-- Compte à rebours -->
                <div class="countdown-container">
                    <h3 class="countdown-title-main">Le Grand Jour Dans</h3>
                    <div class="countdown-display">
                        <div class="countdown-box">
                            <span class="countdown-number" id="days">0</span>
                            <span class="countdown-label">Jours</span>
                        </div>
                        <div class="countdown-box">
                            <span class="countdown-number" id="hours">0</span>
                            <span class="countdown-label">Heures</span>
                        </div>
                        <div class="countdown-box">
                            <span class="countdown-number" id="minutes">0</span>
                            <span class="countdown-label">Minutes</span>
                        </div>
                        <div class="countdown-box">
                            <span class="countdown-number" id="seconds">0</span>
                            <span class="countdown-label">Secondes</span>
                        </div>
                    </div>
                </div>

                <!-- Détails -->
                <div class="details-container">
                    <div class="detail-row">
                        <div class="detail-icon-wrapper">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-title">Date</div>
                            <div class="detail-info">Samedi 8 Février 2026</div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-icon-wrapper">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-title">Horaire</div>
                            <div class="detail-info">Cérémonie à 15h00 · Réception à 18h00</div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-icon-wrapper">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-title">Lieu</div>
                            <div class="detail-info">Domaine des Jardins Éternels<br>Chemin de la Nature, 78000 Campagne</div>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-icon-wrapper">
                            <i class="fas fa-gem"></i>
                        </div>
                        <div class="detail-content">
                            <div class="detail-title">Tenue</div>
                            <div class="detail-info">Élégance champêtre de rigueur</div>
                        </div>
                    </div>
                </div>

                <div class="elegant-divider">
                    <span class="divider-icon">❖</span>
                </div>

                <!-- RSVP Section -->
                <div class="rsvp-section">
                    @if (Model.Status == Web.Models.RsvpStatus.Pending)
                    {
                        <div class="rsvp-form">
                            <h3 class="rsvp-title">Cher(e) @Model.FirstName @Model.LastName</h3>
                            <p class="rsvp-question">Serez-vous des nôtres ?</p>
                            
                            <div class="attendance-choice">
                                <button class="rsvp-button" onclick="selectAttendance(true)">
                                    <i class="fas fa-check-circle"></i> Oui, je serai présent(e)
                                </button>
                                <button class="rsvp-button no-button" onclick="selectAttendance(false)">
                                    <i class="fas fa-times-circle"></i> Non, je ne pourrai pas venir
                                </button>
                            </div>

                            <div id="attendanceDetails">
                                <div class="form-group">
                                    <label>Nombre de personnes (maximum @Model.NumberOfPeople) :</label>
                                    <input type="number" id="guestCount" min="1" max="@Model.NumberOfPeople" value="1" class="form-control">
                                </div>
                                
                                <div class="form-group">
                                    <label>Contraintes alimentaires (optionnel) :</label>
                                    <textarea id="dietaryRestrictions" class="form-control" rows="3" placeholder="Allergies, régime végétarien, vegan, etc."></textarea>
                                </div>

                                <button class="rsvp-button submit-button" onclick="submitRsvp()">
                                    <i class="fas fa-paper-plane"></i> Confirmer ma réponse
                                </button>
                            </div>
                        </div>
                    }
                    else if (Model.Status == Web.Models.RsvpStatus.Confirmed)
                    {
                        <div class="rsvp-confirmed">
                            <i class="fas fa-check-circle success-icon"></i>
                            <h3>Merci @Model.FirstName !</h3>
                            <p>Votre présence est confirmée</p>
                            <p>(@Model.NumberOfPeople personne@(Model.NumberOfPeople > 1 ? "s" : ""))</p>
                            @if (!string.IsNullOrEmpty(Model.DietaryRestrictions))
                            {
                                <p>Contraintes: @Model.DietaryRestrictions</p>
                            }
                            <p class="confirmed-date">Confirmé le @Model.RsvpToken.UsedAt?.ToString("dd/MM/yyyy à HH:mm")</p>
                        </div>
                    }
                    else
                    {
                        <div class="rsvp-declined">
                            <i class="fas fa-heart-broken declined-icon"></i>
                            <h3>Nous sommes désolés de votre absence</h3>
                            <p>Merci de nous avoir prévenus</p>
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="card-footer">
                    <div class="footer-icon">♥</div>
                    <p class="footer-text">
                        Votre présence est le plus précieux des cadeaux<br>
                        et illuminera notre bonheur
                    </p>
                    <p class="footer-signature">
                        Avec tout notre amour,<br>@coupleName1 & @coupleName2
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script>
        // Configuration
        const invitationId = "@Model.RsvpToken.Token";
        const weddingDate = new Date("@weddingDate").getTime();
        let isAttending = false;

        // Créer les particules de lumière
        function createLightParticles() {
            const container = document.getElementById('lightParticles');
            for (let i = 0; i < 50; i++) {
                const particle = document.createElement('div');
                particle.className = 'light-particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.top = Math.random() * 100 + '%';
                particle.style.setProperty('--tx', (Math.random() - 0.5) * 200 + 'px');
                particle.style.setProperty('--ty', (Math.random() - 0.5) * 200 + 'px');
                particle.style.animationDelay = Math.random() * 8 + 's';
                particle.style.animationDuration = (Math.random() * 4 + 6) + 's';
                container.appendChild(particle);
            }
        }

        // Créer les particules de fond
        function createBgParticles() {
            const container = document.getElementById('invitationBg');
            for (let i = 0; i < 80; i++) {
                const particle = document.createElement('div');
                particle.className = 'bg-particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.animationDelay = Math.random() * 10 + 's';
                particle.style.animationDuration = (Math.random() * 8 + 8) + 's';
                container.appendChild(particle);
            }
        }

        // Mise à jour du compte à rebours
        function updateCountdown() {
            const now = new Date().getTime();
            const distance = weddingDate - now;

            if (distance < 0) {
                document.getElementById('days').textContent = '0';
                document.getElementById('hours').textContent = '0';
                document.getElementById('minutes').textContent = '0';
                document.getElementById('seconds').textContent = '0';
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById('days').textContent = days;
            document.getElementById('hours').textContent = hours;
            document.getElementById('minutes').textContent = minutes;
            document.getElementById('seconds').textContent = seconds;
        }

        // Ouvrir l'invitation
        function openInvitation() {
            const homePage = document.getElementById('homePage');
            const invitationPage = document.getElementById('invitationPage');
            
            homePage.style.opacity = '0';
            homePage.style.transform = 'scale(1.1)';
            homePage.style.filter = 'blur(30px)';
            
            setTimeout(() => {
                homePage.style.display = 'none';
                invitationPage.style.display = 'block';
                window.scrollTo({ top: 0, behavior: 'smooth' });
                
                createBgParticles();
                updateCountdown();
                setInterval(updateCountdown, 1000);
            }, 1200);
        }

        // Sélection de présence
        function selectAttendance(attending) {
            isAttending = attending;
            const detailsDiv = document.getElementById('attendanceDetails');
            
            if (attending) {
                detailsDiv.style.display = 'block';
            } else {
                if (confirm('Êtes-vous sûr(e) de ne pas pouvoir venir ? 😢')) {
                    submitRsvp();
                }
            }
        }

        // Soumission RSVP
        async function submitRsvp() {
            const guestCount = isAttending ? parseInt(document.getElementById('guestCount')?.value || 1) : 0;
            const dietaryRestrictions = document.getElementById('dietaryRestrictions')?.value || '';

            const data = {
                token: '@Model.RsvpToken.Token',
                status: isAttending ? 1 : 2,
                numberOfPeople: guestCount,
                dietaryRestrictions: dietaryRestrictions
            };

            try {
                const response = await fetch('/Rsvp/Submit2', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    // Redirection vers la page de confirmation
                    window.location.href = result.redirectUrl;
                } else {
                    alert('❌ ' + (result.message || 'Une erreur est survenue'));
                }
            } catch (error) {
                alert('❌ Une erreur est survenue. Veuillez réessayer.');
                console.error('Error:', error);
            }
        }

        // Initialisation au chargement
        window.onload = function() {
            createLightParticles();
        };
    </script>
</body>
</html>