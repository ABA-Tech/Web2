@model Web.Models.ViewModels.RsvpViewModel
@{
    Layout = null;
    var coupleName1 = "Sophie";
    var coupleName2 = "Alexandre";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réponse Enregistrée - @coupleName1 & @coupleName2</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@200;300;400;500;600&family=Playfair+Display:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/t1.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/respond.css" asp-append-version="true" />
    <style>
 
    </style>
</head>
<body>
    <div class="already-responded-page">
        <div class="invitation-bg" id="invitationBg"></div>
        
        <!-- Lignes décoratives -->
        <div class="decorative-line" style="top: 20%; width: 100%; animation-delay: 0s;"></div>
        <div class="decorative-line" style="top: 50%; width: 100%; animation-delay: 2s;"></div>
        <div class="decorative-line" style="top: 80%; width: 100%; animation-delay: 4s;"></div>

        <div class="response-card">
            <!-- Bordures animées -->
            <div class="card-border card-border-top"></div>
            <div class="card-border card-border-bottom"></div>
            <div class="card-border card-border-left"></div>
            <div class="card-border card-border-right"></div>

            <!-- Coins ornementaux -->
            <div class="corner-ornament corner-tl"></div>
            <div class="corner-ornament corner-tr"></div>
            <div class="corner-ornament corner-bl"></div>
            <div class="corner-ornament corner-br"></div>

            <div class="response-icon">
                <i class="fas fa-check-circle"></i>
            </div>

            <h1 class="response-title">Réponse Déjà Enregistrée</h1>
            <p class="response-subtitle">Votre réponse a été prise en compte</p>

            <div class="elegant-divider">
                <span class="divider-icon">❖</span>
            </div>

            <div class="summary-box">
                <h3 class="summary-title">Récapitulatif de votre réponse</h3>

                <div class="summary-row">
                    <span class="summary-label">Invité(e)</span>
                    <span class="summary-value">@Model.Guest.FullName</span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Statut</span>
                    @if (Model.Guest.Status == Web.Models.RsvpStatus.Confirmed)
                    {
                        <span class="status-badge status-confirmed">
                            <i class="fas fa-check"></i> Présence Confirmée
                        </span>
                    }
                    else if (Model.Guest.Status == Web.Models.RsvpStatus.Declined)
                    {
                        <span class="status-badge status-declined">
                            <i class="fas fa-times"></i> Absence Confirmée
                        </span>
                    }
                </div>

                @if (Model.Guest.Status == Web.Models.RsvpStatus.Confirmed)
                {
                    <div class="summary-row">
                        <span class="summary-label">Nombre de personnes</span>
                        <span class="summary-value">@Model.Guest.NumberOfPeople</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Guest.DietaryRestrictions))
                    {
                        <div class="summary-row">
                            <span class="summary-label">Contraintes alimentaires</span>
                            <span class="summary-value">@Model.Guest.DietaryRestrictions</span>
                        </div>
                    }
                }

                @if (Model.Guest.RespondedAt.HasValue)
                {
                    <div class="summary-row">
                        <span class="summary-label">Répondu le</span>
                        <span class="summary-value">@Model.Guest.RespondedAt.Value.ToString("dd/MM/yyyy à HH:mm")</span>
                    </div>
                }
            </div>

            <div class="info-box">
                <div class="info-box-title">
                    <i class="fas fa-lightbulb"></i> Besoin de modifier votre réponse ?
                </div>
                <p class="info-box-text">
                    Ce lien ne peut être utilisé qu'une seule fois. Si vous souhaitez modifier votre réponse, 
                    veuillez contacter directement les organisateurs du mariage.
                </p>
            </div>

            <div class="action-buttons">
                <!-- Option 1: Ouvrir dans un nouvel onglet -->
                <a href="@Url.Action("Invitation", "Rsvp", new { id = Model.Token })"
                   class="btn-primary"
                   target="_blank">
                    <i class="fas fa-eye"></i> Voir l'invitation
                </a>

            </div>

            <div class="footer-message">
                <div class="footer-icon">♥</div>
                <p>
                    @if (Model.Guest.Status == Web.Models.RsvpStatus.Confirmed)
                    {
                        <text>Nous avons hâte de célébrer ce jour avec vous !</text>
                    }
                    else
                    {
                        <text>Merci de nous avoir prévenus.</text>
                    }
                </p>
                <p class="footer-signature">
                    @coupleName1 & @coupleName2
                </p>
            </div>
        </div>
    </div>

    <script>
        // Créer les particules de fond
        function createBgParticles() {
            const container = document.getElementById('invitationBg');
            for (let i = 0; i < 80; i++) {
                const particle = document.createElement('div');
                particle.className = 'bg-particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.animationDelay = Math.random() * 10 + 's';
                particle.style.animationDuration = (Math.random() * 8 + 8) + 's';
                container.appendChild(particle);
            }
        }

        window.onload = function() {
            createBgParticles();
        };
    </script>
</body>
</html>
